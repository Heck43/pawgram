"""
In-App Notifications Plugin for Pawgram Desktop
Внутриклиентские всплывающие уведомления (Bulletins) для Telegram Desktop.
"""

from typing import Any, List
from base_plugin import BasePlugin, HookResult, HookStrategy, MessageParams
from ui.settings import Header, Switch, Input, Divider, Text, Selector
import client_utils
import winsound

__id__ = "in_app_notifications"
__name__ = "In-App Notifications"
__author__ = "@meeowPlugins"
__version__ = "1.2.1"
__description__ = "Плагин с гибкими настройками отображающий уведомления Telegram локально внутри приложения."

class InAppNotificationsPlugin(BasePlugin):
    def on_plugin_load(self):
        super().on_plugin_load()
        self.add_on_send_message_hook()
        client_utils.show_bulletin(
            title="In-App Notifications",
            subtitle="Плагин успешно активирован!",
            duration_sec=3.0
        )
        self.logger.info("InAppNotificationsPlugin loaded and active!")

    def on_plugin_unload(self):
        self.logger.info("InAppNotificationsPlugin unloaded.")

    def create_settings(self) -> List[Any]:
        return [
            # 1. Раздел: Настройки
            Header("Настройки"),
            Switch(
                key="all_notifications",
                text="Все уведомления",
                subtext="Отображать всплывающие плашки для всех входящих событий",
                default=False
            ),
            Switch(
                key="mentions",
                text="Упоминания",
                subtext="Уведомлять при ответе или упоминании через @username",
                default=True
            ),
            Switch(
                key="unmuted",
                text="Не заглушенные",
                subtext="Показывать плашки только для чатов со включенным звуком",
                default=True
            ),
            Switch(
                key="all_pms",
                text="Все ЛС",
                subtext="Всплывающие уведомления для личных сообщений",
                default=True
            ),
            Switch(
                key="archive",
                text="Архив",
                subtext="Показывать плашки для чатов, находящихся в архиве",
                default=False
            ),

            Divider(),

            # 2. Раздел: Чаты
            Header("Чаты"),
            Switch(
                key="chat_groups",
                text="Группы",
                subtext="Всплывающие уведомления в групповых чатах",
                default=True
            ),
            Switch(
                key="chat_channels",
                text="Каналы",
                subtext="Всплывающие уведомления для постов в каналах",
                default=True
            ),
            Switch(
                key="chat_private",
                text="Приватные чаты",
                subtext="Уведомления для личных диалогов",
                default=True
            ),
            Switch(
                key="chat_bots",
                text="Боты",
                subtext="Всплывающие уведомления от ботов",
                default=True
            ),

            Divider(),

            # 3. Раздел: Кастомизация
            Header("Кастомизация"),
            Switch(
                key="show_on_top",
                text="Отображать уведомление наверху",
                subtext="Показывать капсулу в верхней части окна чата",
                default=True
            ),
            Input(
                key="duration",
                text="Длительность (секунды)",
                subtext="Время отображения уведомления на экране",
                default="4.0"
            ),
            Switch(
                key="sound",
                text="Звуковой сигнал",
                subtext="Воспроизводить системный звук при показе плашки",
                default=False
            ),
            Switch(
                key="notify_on_send",
                text="Уведомлять при отправке",
                subtext="Показывать плашку при отправке своих сообщений",
                default=False
            ),

            Divider(),

            # 4. Раздел: Команды теста
            Header("Тестирование"),
            Text(
                text=".notify <текст>",
                subtext="Отправляет тестовое всплывающее уведомление"
            ),
            Text(
                text=".bulletin <заголовок> | <текст>",
                subtext="Отправляет плашку с произвольным заголовком и текстом"
            )
        ]

    def on_send_message_hook(self, account: int, params: MessageParams) -> HookResult:
        if not hasattr(params, "message") or not isinstance(params.message, str):
            return HookResult(strategy=HookStrategy.PASS)

        text = params.message.strip()

        try:
            duration = float(self.get_setting("duration", "4.0"))
        except (ValueError, TypeError):
            duration = 4.0

        play_sound = self.get_setting("sound", False)

        # Команда .notify <текст>
        if text.startswith(".notify"):
            parts = text.split(" ", 1)
            content = parts[1].strip() if len(parts) > 1 else "Тестовое уведомление"

            if play_sound:
                try:
                    winsound.MessageBeep(winsound.MB_ICONASTERISK)
                except Exception:
                    pass

            client_utils.show_bulletin("Уведомление", content, duration)
            self.logger.info(f"Triggered .notify: {content}")
            return HookResult(strategy=HookStrategy.CANCEL)

        # Команда .bulletin <заголовок> | <текст>
        if text.startswith(".bulletin"):
            parts = text.split(" ", 1)
            raw = parts[1].strip() if len(parts) > 1 else "Заголовок | Текст сообщения"

            if "|" in raw:
                title, subtitle = raw.split("|", 1)
                title = title.strip()
                subtitle = subtitle.strip()
            else:
                title = "Telegram Bulletin"
                subtitle = raw

            if play_sound:
                try:
                    winsound.MessageBeep(winsound.MB_ICONASTERISK)
                except Exception:
                    pass

            client_utils.show_bulletin(title, subtitle, duration)
            self.logger.info(f"Triggered .bulletin: {title} - {subtitle}")
            return HookResult(strategy=HookStrategy.CANCEL)

        # Уведомление при обычной отправке (если включено в настройках)
        if self.get_setting("notify_on_send", False) and not text.startswith("."):
            if play_sound:
                try:
                    winsound.MessageBeep(winsound.MB_OK)
                except Exception:
                    pass
            client_utils.show_bulletin("Отправлено", text, min(duration, 2.5))

        return HookResult(strategy=HookStrategy.PASS)
