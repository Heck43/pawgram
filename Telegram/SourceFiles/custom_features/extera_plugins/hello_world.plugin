"""
Hello World Demo Plugin for Pawgram Desktop
Простейший демонстрационный плагин для проверки работы Python Engine.
"""

from typing import Any, List
from base_plugin import BasePlugin, HookResult, HookStrategy, MessageParams
from ui.settings import Header, Switch, Input, Divider, Text
import client_utils

__id__ = "hello_world"
__name__ = "Hello World"
__version__ = "1.0.0"
__author__ = "@Pawgram"
__description__ = "Демонстрационный плагин. Реагирует на команды .hello, .hw и .привет, заменяет текст или показывает плашку."

class HelloWorldPlugin(BasePlugin):
    def on_plugin_load(self):
        super().on_plugin_load()
        self.add_on_send_message_hook()
        client_utils.show_bulletin(
            title="Hello World!",
            subtitle="Плагин успешно загружен и готов к работе!",
            duration_sec=3.5
        )
        self.logger.info("HelloWorldPlugin loaded successfully!")

    def on_plugin_unload(self):
        self.logger.info("HelloWorldPlugin unloaded.")

    def create_settings(self) -> List[Any]:
        return [
            Header("Настройки"),
            Switch(
                key="enabled",
                text="Включить плагин",
                subtext="Основной переключатель работы плагина",
                default=True
            ),
            Switch(
                key="show_bulletin",
                text="Всплывающее уведомление (Буллетин)",
                subtext="Показывать красивую капсулу вверху экрана при срабатывании",
                default=True
            ),
            Switch(
                key="replace_message",
                text="Отправлять сообщение в чат",
                subtext="Если выключено, команда только покажет плашку и не отправит сообщение собеседнику",
                default=True
            ),
            Divider(),
            Header("Кастомизация текста"),
            Input(
                key="greeting_text",
                text="Текст приветствия",
                subtext="Текст, который будет отправлен в чат",
                default="Hello, World! (отправлено через плагин Pawgram)"
            ),
            Divider(),
            Header("Команды"),
            Text(
                text=".hello или .hw или .привет",
                subtext="Отправляет приветствие или показывает тестовую плашку"
            ),
        ]

    def on_send_message_hook(self, account: int, params: MessageParams) -> HookResult:
        if not self.get_setting("enabled", True):
            return HookResult(strategy=HookStrategy.PASS)

        if not hasattr(params, "message") or not isinstance(params.message, str):
            return HookResult(strategy=HookStrategy.PASS)

        text = params.message.strip()

        # Проверяем команды .hello, .hw, .привет
        if text.lower() in (".hello", ".hw", ".привет") or text.lower().startswith((".hello ", ".hw ", ".привет ")):
            self.logger.info(f"HelloWorldPlugin intercepted command: {text}")

            if self.get_setting("show_bulletin", True):
                client_utils.show_bulletin(
                    title="Hello World!",
                    subtitle="Команда успешно выполнена!",
                    duration_sec=3.5
                )

            if self.get_setting("replace_message", True):
                greeting = self.get_setting("greeting_text", "Hello, World! (отправлено через плагин Pawgram)")
                params.message = greeting
                return HookResult(strategy=HookStrategy.MODIFY, params=params)
            else:
                # Отменяем отправку сообщения в чат
                return HookResult(strategy=HookStrategy.CANCEL)

        return HookResult(strategy=HookStrategy.PASS)
